<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Riqian</AssemblyName>
    <RootNamespace>Riqian</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!--
      版本号只有一个来源就是这里，其它地方全部引用它：
        · Diag.AppVersion 读 Assembly.GetName().Version（即下面的 Version）
        · /health 接口报的就是这个值
        · exe 右键属性「详细信息」看到的是 FileVersion
      以前这里是 5.0.0，而界面更新日志写 12.9.5、README 写 v12.8 ——
      三个数字互不相同，用户看属性看到一个版本、看更新日志又看到另一个。
      统一到 12.9.5（跟 changelog 对齐）。改版本只改这一处。
    -->
    <Version>12.9.6</Version>
    <!--
      这两个必须跟着 <Version> 一起改。
      2026-11-11 发现日志里报的版本是 12.9.5，而 csproj 的 <Version> 已经是 12.9.6 ——
      因为 Diag 的 Snapshot 读的是**程序集版本**，而 AssemblyVersion 忘了同步。
      后果不大但很误导：拿着 12.9.6 的包去查 12.9.5 的 bug，或者反过来。
    -->
    <FileVersion>12.9.6.0</FileVersion>
    <AssemblyVersion>12.9.6.0</AssemblyVersion>
    <Product>日签 · 打卡日记本</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      单文件发布的两个必须项，写死在这里免得每次发布靠记忆：
      - PublishSingleFile：托管程序集打包成一个 exe
      - IncludeNativeLibrariesForSelfExtract：把 e_sqlite3.dll 这类原生库也塞进 exe，
        启动时解压到 %TEMP%\.net\日签\<哈希>\ 再加载。
        少了这一条，SQLite 会静态初始化失败（DllNotFoundException: e_sqlite3），
        程序连主界面都出不来。
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <!--
    android/ 是**独立的项目目录**（有自己的 csproj），要从桌面项目的默认通配里排除。

    不排除会怎样：SDK 风格的 csproj 默认把 **/*.cs 全收进来，于是
    android\MainActivity.cs 也被编进桌面程序，报一堆
    「未能找到类型或命名空间名 Android」。这个错误信息完全指错方向 ——
    它看起来像 android workload 没装好，实际上是项目边界没划清。
  -->
  <ItemGroup>
    <Compile Remove="android\**" />
    <None Remove="android\**" />
    <EmbeddedResource Remove="android\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="index.html" />
    <!--
      KaTeX 的 20 个字体（约 304 KB）作为独立资源嵌入，由 HtmlHost.WriteFonts 在启动时
      落到 %TEMP%\Riqian\ui\fonts\。

      为什么不继续 base64 塞在 CSS 里：base64 有 33% 膨胀（254 KB → 346 KB 文本），
      而且字体字节几乎不可压缩，会把整个 index.html 的压缩率拖死
      （实测 CSS 含字体 gzip 284 KB vs 不含 27 KB）。外置后整包小 327 KB。

      LogicalName 前缀 Riqian.fonts. 是 HtmlHost.FontPrefix 依赖的命名约定，改要同步。
    -->
    <EmbeddedResource Include="wwwroot\fonts\*.woff2" LogicalName="Riqian.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    从 GitHub clone 下来的人最容易踩的坑：直接 dotnet build，报
    「找不到 wwwroot/index.html」或者更莫名的资源错误。
    真实原因是前端产物要 npm run build 才生成，而它被 .gitignore 忽略过一段时间。

    这里在编译前检查一下，缺了就用一句人话说明该干什么，
    而不是让人对着一行 MSB3030 猜。注意：只是诊断，不自动去跑 npm ——
    编译过程偷偷装依赖会让离线环境直接失败。
  -->
  <Target Name="CheckFrontendBuilt" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_UiHtml>$(MSBuildProjectDirectory)\wwwroot\index.html</_UiHtml>
    </PropertyGroup>
    <Warning
      Condition="!Exists('$(_UiHtml)')"
      Text="wwwroot/index.html 不存在 —— 这是内嵌的界面产物。先在 web 目录跑：npm install &amp;&amp; npm run build（需要 Node 18+），再 dotnet build。" />
  </Target>

</Project>
