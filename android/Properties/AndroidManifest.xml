<?xml version="1.0" encoding="utf-8"?>
<!--
  日签安卓版清单。

  权限只声明真正需要的，不多要 —— 日记本这种应用一旦索要「读取所有文件」，
  用户第一反应就是不敢装。这里每一项都对应一个具体功能：

    INTERNET            网络音频播放（用户自己粘的 URL）、用系统浏览器打开外链
    POST_NOTIFICATIONS  Android 13 起发通知必须先声明，否则提醒功能静默失效
    VIBRATE             番茄钟/提醒的震动（有就用，没有也不影响功能）
    WAKE_LOCK           计时期间别让屏幕熄掉（番茄钟）

  不声明 READ_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE：
  导入图片走系统文件选择器（SAF），用 SAF 拿到的 URI 不需要任何存储权限。
  这是 Android 10 之后的正路，也是唯一不给用户添堵的做法。

  usesCleartextTraffic：媒体库里可能有用户自己填的 http:// 音频地址，
  默认（Android 9+）会拦掉明文 HTTP，导致「链接音频」放不出声。
  这个应用的数据全在本机，没有账号密码走网络，放开明文的风险可以接受。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application
      android:label="日签"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:largeHeap="true"
      android:usesCleartextTraffic="true"
      android:hardwareAccelerated="true" />
</manifest>
